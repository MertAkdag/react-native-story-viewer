    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "expo-image": "^55.0.9",
    "expo-video": "^55.0.15",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.30.0",

{
  "name": "@mertakdag/react-native-story-viewer",
  "version": "1.1.0",
  "description": "Instagram & Snapchat-style story tray and full-screen story viewer for React Native & Expo — with image/video sync, gestures, and a headless hook API.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "homepage": "https://github.com/MertAkdag/react-native-story-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MertAkdag/react-native-story-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/MertAkdag/react-native-story-viewer/issues"
  },
  "files": [
    "src",
    "lib",
    "!**/.DS_Store",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "expo",
    "stories",
    "story-viewer",
    "instagram-stories",
    "snapchat-stories",
    "story-tray",
    "reanimated",
    "gesture-handler",
    "expo-video",
    "expo-image",
    "headless-ui",
    "typescript"
  ],
  "author": "Mert Akdag <mert@mertakdag.com> (https://mertakdag.com)",
  "license": "MIT",
  "peerDependencies": {
    "expo-image": "*",
    "expo-video": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "expo-image": "^55.0.9",
    "expo-video": "^55.0.15",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.30.0",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-reanimated": "^4.3.0",
    "react-native-safe-area-context": "^5.7.0",
    "typescript": "^5.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
